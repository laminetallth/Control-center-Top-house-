rules_version = '2';

// Regole Firestore del progetto "top-house-gestionale" (gestionale amministrazione).
// Pubblicale da Firebase Console → Firestore Database → Regole → incolla tutto → Pubblica.
// Gli account del gestionale si creano solo da Authentication → Utenti → Aggiungi utente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
